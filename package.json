{
  "name": "my-claude-sandbox",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check --error-on-warnings",
    "format": "biome format --write",
    "lint:fix": "biome check --write app components lib proxy.ts",
    "supabase:start": "pnpm supabase start",
    "supabase:stop": "pnpm supabase stop",
    "test:guard": "node --test scripts/agent-guard/",
    "db:types": "mkdir -p lib && pnpm supabase gen types typescript --local > lib/database.types.ts",
    "db:types:check": "node scripts/check-db-types.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "supabase": "^2.120.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
