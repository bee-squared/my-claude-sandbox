// Biome's GritQL can't read the `type` keyword from the syntax tree, so these regexes parse the
// statement text. They deliberately don't understand comments: any comment inside the statement
// fails the exemptions and is denied, so move it above the statement. Parsing comments here
// let runtime imports through (see the tests), so don't add it back.
or {
  JsImport(),
  JsExport()
} as $e where {
  $e <: contains or {
    `"@supabase/supabase-js"`,
    `'@supabase/supabase-js'`
  },
  $e <: or {
    r"import[\s\S]*",
    r"export\s*(?:[*{]|/[/*])[\s\S]*"
  },
  $e <: not or {
    r"(?:import|export)\s+type\s*[{*][\s\S]*",
    r"import\s+type\s+[\w$]+\s+from\b[\s\S]*",
    r"(?:import|export)\s*\{\s*(?:type\s+(?:[\w$]+|\"[^\"]*\"|'[^']*')(?:\s+as\s+(?:[\w$]+|\"[^\"]*\"|'[^']*'))?\s*,?\s*)+\}[\s\S]*"
  },
  register_diagnostic(span=$e, message="Use @supabase/ssr clients from @/lib/supabase", severity="error")
}
