or {
  `process.env.SUPABASE_SECRET_KEY`,
  `process.env["SUPABASE_SECRET_KEY"]`,
  `process.env?.SUPABASE_SECRET_KEY`,
  `process.env?.["SUPABASE_SECRET_KEY"]`,
  `process?.env.SUPABASE_SECRET_KEY`,
  `process?.env["SUPABASE_SECRET_KEY"]`,
  `process?.env?.SUPABASE_SECRET_KEY`,
  `process?.env?.["SUPABASE_SECRET_KEY"]`
} as $e where {
  register_diagnostic(span=$e, message="SUPABASE_SECRET_KEY is backend-only; request an RPC (docs/contracts/requests/)", severity="error")
}
